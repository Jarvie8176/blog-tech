flowchart TB
  human["Human operator"] -->|"Read and check"| docs["Runbook instructions"]
  agent["AI agent"] -->|"Read as needed"| docs
  docs -.->|"Script entry"| terminal["Human / agent CLI"]
  docs -.->|"Registered operation"| dispatcher["Agent MCP entry"]
  docs -.->|"Config entry"| change["Human / agent PR"]
  terminal -->|"Arguments / preconditions"| script["Versioned scripts"]
  dispatcher -->|"Arguments / scope / gate"| script
  change -->|"Checked, authorized merge"| controller["Controller such as doco-cd"]
  script -->|"SSH / CLI / service API"| service["Services and runtime"]
  controller -->|"Pull and deploy config"| service
  service -->|"State and application results"| verify["Independent checks"]
  verify -->|"Record evidence"| receipt["Human / agent review"]
