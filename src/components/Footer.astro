---
import { execFileSync } from 'node:child_process';
import process from 'node:process';
import { REPO, SITE, type Locale } from '../config';
import { localizedPath, useTranslations } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();
const footerLeftText = SITE.footer.leftText?.trim();
const footerRightText = SITE.footer.rightText?.trim();
const showPrivacyPolicy = SITE.footer.showPrivacyPolicy ?? SITE.showPrivacyPolicy;
const showThemeCredits = SITE.footer.showThemeCredits ?? true;
let revision = process.env.GITHUB_SHA || process.env.CF_PAGES_COMMIT_SHA || '';
if (!revision) {
  try {
    revision = execFileSync('git', ['rev-parse', 'HEAD'], {
      encoding: 'utf8',
      stdio: ['ignore', 'pipe', 'ignore'],
    }).trim();
  } catch {
    // Source archives without Git metadata still link to the repository.
  }
}
const sourceRevision = /^[a-f0-9]{40}$/.test(revision) ? revision : undefined;
const sourceUrl = sourceRevision ? `${REPO.url}/commit/${sourceRevision}` : REPO.url;
const resolvedLeftText = footerLeftText
  ?.replaceAll('{year}', String(year))
  .replaceAll('{author}', SITE.author.name);
---

<footer
  aria-label={t('site.footer')}
  class="border-base-300 text-base-content/70 mt-10 flex flex-col gap-1 border-t py-6 text-sm lg:flex-row lg:items-center lg:justify-between"
>
  <p>
    {
      resolvedLeftText ? (
        resolvedLeftText
      ) : (
        <>
          © <time>{year}</time>{' '}
          <a href={SITE.author.url ?? '#'} rel="noopener" class="hover:text-primary">
            {SITE.author.name}
          </a>
        </>
      )
    }
    {
      showPrivacyPolicy && (
        <>
          {' · '}
          <a href={localizedPath('/privacy', locale)} class="hover:text-primary">
            {t('footer.privacy')}
          </a>
        </>
      )
    }
  </p>
  <p>
    {
      footerRightText ? (
        <>
          {footerRightText}
          {showThemeCredits && (
            <>
              {' · '}
              {t('footer.theme')}{' '}
              <a href={SITE.footer.themeUrl} rel="noopener" class="hover:text-primary">
                {SITE.footer.themeName}
              </a>
            </>
          )}
        </>
      ) : showThemeCredits ? (
        <>
          {t('footer.poweredBy')}{' '}
          <a href="https://astro.build" rel="noopener" class="hover:text-primary">
            Astro
          </a>{' '}
          · {t('footer.theme')}{' '}
          <a href={SITE.footer.themeUrl} rel="noopener" class="hover:text-primary">
            {SITE.footer.themeName}
          </a>
        </>
      ) : null
    }
    {(footerRightText || showThemeCredits) && ' · '}
    <a
      href={sourceUrl}
      title={sourceRevision}
      aria-label={t('footer.source')}
      class="hover:text-primary whitespace-nowrap"
    >
      GitHub{
        sourceRevision && (
          <>
            {' '}
            · <code>{sourceRevision.slice(0, 7)}</code>
          </>
        )
      }
    </a>
  </p>
</footer>
