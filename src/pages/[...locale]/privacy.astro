---
import { getEntry, render } from 'astro:content';
import PageLayout from '~/layouts/PageLayout.astro';
import { ANALYTICS, SITE } from '~/config';
import { useTranslations } from '~/i18n/utils';

export function getStaticPaths() {
  return SITE.locales.map((l) => ({
    params: { locale: l === SITE.defaultLocale ? undefined : l },
    props: { locale: l },
  }));
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const entry = await getEntry('pages', `${locale}/privacy`);
if (!entry) return Astro.rewrite('/404');
const { Content } = await render(entry);
---

<PageLayout
  title={entry.data.title}
  description={entry.data.description ?? SITE.description}
  locale={locale}
  math={entry.data.math}
>
  <p>{t(ANALYTICS.enabled ? 'privacy.analyticsEnabled' : 'privacy.analyticsDisabled')}</p>
  <Content />
</PageLayout>
