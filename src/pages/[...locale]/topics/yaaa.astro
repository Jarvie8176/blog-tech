---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PostList from '~/components/PostList.astro';
import { SITE } from '~/config';
import { useTranslations, localizedPath } from '~/i18n/utils';
import { getPosts } from '~/utils/posts';

export function getStaticPaths() {
  return SITE.locales.map((locale) => ({
    params: { locale: locale === SITE.defaultLocale ? undefined : locale },
    props: { locale },
  }));
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const posts = (await getPosts(locale)).filter((post) => post.data.categories.includes('Yaaa'));
---

<BaseLayout
  title={t('yaaa.title')}
  description={t('yaaa.description')}
  pathWithoutLocale="/topics/yaaa/"
  crumbs={[
    { label: t('nav.topics'), href: localizedPath('/topics/', locale) },
    { label: t('nav.yaaa') },
  ]}
>
  <section data-pagefind-body class="border-base-300 mb-8 border-b pb-6">
    <h1 class="text-3xl font-bold tracking-tight">{t('yaaa.title')}</h1>
    <p class="text-base-content/70 mt-3 text-lg">{t('yaaa.intro')}</p>
  </section>
  <PostList posts={posts} locale={locale} />
</BaseLayout>
